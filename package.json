{
  "name": "prosemirror-breadcrumbs",
  "version": "1.0.0",
  "description": "Breadcrumb navigation for ProseMirror editors",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "style"
  ],
  "exports": {
    "./style/breadcrumbs.css": "./style/breadcrumbs.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "prosemirror-commands": "^1.7.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
